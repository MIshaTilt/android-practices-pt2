<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".presentation.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WeatherWardrobe — Каркас Clean Architecture (Пр. 1)"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Введите город (Москва, Сочи, СПб, Новосибирск)"
            android:importantForAutofill="no"
            android:inputType="text" />

        <Button
            android:id="@+id/buttonSaveCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Сохранить город (SharedPreferences) и подобрать гардероб" />

        <Button
            android:id="@+id/buttonShowCatalog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Показать весь каталог и личный гардероб" />

        <Button
            android:id="@+id/buttonTestAiScanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Тест TFLite UseCase (Распознать вещь и сохранить)" />

        <Button
            android:id="@+id/buttonToggleAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Переключить режим (Гость / Авторизован)" />

        <TextView
            android:id="@+id/textViewOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#F3F4F6"
            android:padding="12dp"
            android:text="Нажмите кнопку для вызова UseCase..."
            android:textColor="#111827"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
